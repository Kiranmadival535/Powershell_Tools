$script:lastResults = @()

function Find-ReportFile {
    param(
        [string]$App,
        [string]$Month
    )
    # flexible match: *app*month*.csv (case-insensitive)
    Get-ChildItem -Path $reportsFolder -Recurse -File -ErrorAction SilentlyContinue `
        -Include "*$App*${Month}*.csv" | Select-Object -First 1
}

function Compare-Reports {
    $dataGridView.Rows.Clear()
    $script:lastResults = @()
    $toolStripProgressBar.Value = 0

    $selectedApp = $cbApp.SelectedItem
    $oldMonth    = $cbOld.SelectedItem
    $newMonth    = $cbNew.SelectedItem

    if (-not $oldMonth -or -not $newMonth) {
        [System.Windows.Forms.MessageBox]::Show("Please select both Old and New months.")
        return
    }

    $apps = if ($selectedApp -eq "All") { @("Database","Oracle","Active Directory") } else { @($selectedApp) }
    $count = $apps.Count
    $i = 0

    foreach ($app in $apps) {
        $i++
        $pct = [math]::Floor(($i / $count) * 100)
        $toolStripProgressBar.Value = [Math]::Min($pct, 100)

        $oldFile = Find-ReportFile -App $app -Month $oldMonth
        $newFile = Find-ReportFile -App $app -Month $newMonth

        if (-not $oldFile -or -not $newFile) {
            $script:lastResults += [PSCustomObject]@{ Application=$app; Username="N/A"; Status="Report Missing" }
            continue
        }

        $oldData = Import-Csv $oldFile.FullName
        $newData = Import-Csv $newFile.FullName

        # Handle missing columns gracefully
        $oldUsers = @()
        $newUsers = @()
        if ($oldData -and ($oldData | Get-Member -Name Username -MemberType NoteProperty)) {
            $oldUsers = $oldData.Username | Where-Object { $_ } | ForEach-Object { $_.Trim() } | Sort-Object -Unique
        }
        if ($newData -and ($newData | Get-Member -Name Username -MemberType NoteProperty)) {
            $newUsers = $newData.Username | Where-Object { $_ } | ForEach-Object { $_.Trim() } | Sort-Object -Unique
        }

        # Compare
        $added   = $newUsers | Where-Object { $_ -notin $oldUsers }
        $removed = $oldUsers | Where-Object { $_ -notin $newUsers }
        $unchanged = $newUsers | Where-Object { $_ -in $oldUsers }

        foreach ($u in $added)    { $script:lastResults += [PSCustomObject]@{ Application=$app; Username=$u; Status="Added" } }
        foreach ($u in $removed)  { $script:lastResults += [PSCustomObject]@{ Application=$app; Username=$u; Status="Removed" } }
        foreach ($u in $unchanged){ $script:lastResults += [PSCustomObject]@{ Application=$app; Username=$u; Status="Unchanged" } }
    }

    Render-Results
}

function Apply-Filter([System.Collections.IEnumerable]$items) {
    switch ($cbFilter.SelectedItem) {
        "Modified Only"  { return $items | Where-Object { $_.Status -ne "Unchanged" } }
        "Unchanged Only" { return $items | Where-Object { $_.Status -eq "Unchanged" } }
        default          { return $items }
    }
}

function Render-Results {
    $dataGridView.Rows.Clear()
    $filtered = Apply-Filter $script:lastResults

    foreach ($r in $filtered) {
        $row = $dataGridView.Rows[$dataGridView.Rows.Add()]
        $row.Cells["Application"].Value = $r.Application
        $row.Cells["Username"].Value    = $r.Username
        $row.Cells["Status"].Value      = $r.Status

        switch ($r.Status) {
            "Added"           { $row.Cells["Status"].Style.BackColor = [System.Drawing.Color]::LightGreen }
            "Removed"         { $row.Cells["Status"].Style.BackColor = [System.Drawing.Color]::LightCoral }
            "Unchanged"       { $row.Cells["Status"].Style.BackColor = [System.Drawing.Color]::Gainsboro }
            "Report Missing"  { $row.Cells["Status"].Style.BackColor = [System.Drawing.Color]::Khaki }
        }
    }
}

function Export-Grid-ToCsv {
    $saveDlg = New-Object System.Windows.Forms.SaveFileDialog
    $saveDlg.Filter = "CSV files (*.csv)|*.csv"
    $saveDlg.FileName = "CompareOutput.csv"
    if ($saveDlg.ShowDialog() -ne "OK") { return }

    $rows = foreach ($row in $dataGridView.Rows) {
        if ($row.Cells["Application"].Value -or $row.Cells["Username"].Value -or $row.Cells["Status"].Value) {
            [PSCustomObject]@{
                Application = $row.Cells["Application"].Value
                Username    = $row.Cells["Username"].Value
                Status      = $row.Cells["Status"].Value
            }
        }
    }
    $rows | Export-Csv -Path $saveDlg.FileName -NoTypeInformation -Force
    [System.Windows.Forms.MessageBox]::Show("Data saved to $($saveDlg.FileName)","Export")
}

function Export-Grid-ToExcel {
    try {
        $excel = New-Object -ComObject Excel.Application
        $excel.Visible = $false
        $wb = $excel.Workbooks.Add()
        $ws = $wb.Worksheets.Item(1)

        $ws.Cells.Item(1,1) = "Application"
        $ws.Cells.Item(1,2) = "Username"
        $ws.Cells.Item(1,3) = "Status"

        $r = 2
        foreach ($row in $dataGridView.Rows) {
            if ($row.Cells["Application"].Value -or $row.Cells["Username"].Value -or $row.Cells["Status"].Value) {
                $ws.Cells.Item($r,1) = $row.Cells["Application"].Value
                $ws.Cells.Item($r,2) = $row.Cells["Username"].Value
                $ws.Cells.Item($r,3) = $row.Cells["Status"].Value
                $r++
            }
        }

        $ws.UsedRange.EntireColumn.AutoFit() | Out-Null

        $saveDlg = New-Object System.Windows.Forms.SaveFileDialog
        $saveDlg.Filter = "Excel Workbook (*.xlsx)|*.xlsx"
        $saveDlg.FileName = "CompareOutput.xlsx"
        if ($saveDlg.ShowDialog() -eq "OK") {
            $wb.SaveAs($saveDlg.FileName)
        }
        $wb.Close($true)
        $excel.Quit()
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null
        [System.Windows.Forms.MessageBox]::Show("Excel export completed.")
    } catch {
        [System.Windows.Forms.MessageBox]::Show("Excel export failed: $_")
    }
}

function Print-Grid {
    try {
        $printDialog = New-Object System.Windows.Forms.PrintDialog
        if ($printDialog.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) { return }

        $printDocument = New-Object System.Drawing.Printing.PrintDocument
        $printDocument.PrinterSettings = $printDialog.PrinterSettings
        $printDocument.add_PrintPage({
            param($sender, $e)
            $font  = New-Object System.Drawing.Font("Arial", 10)
            $brush = [System.Drawing.Brushes]::Black
            $pen   = New-Object System.Drawing.Pen([System.Drawing.Color]::Black)

            $x = 50; $y = 50
            $cellWidth  = 180
            $cellHeight = 25

            # Watermark
            $wmText = "Made By Kiran Madival"
            $wmFont = New-Object System.Drawing.Font("Arial", 20)
            $wmBrush= New-Object System.Drawing.SolidBrush([System.Drawing.Color]::LightGray)
            $sz = $e.Graphics.MeasureString($wmText, $wmFont)
            $e.Graphics.DrawString($wmText, $wmFont, $wmBrush, ($e.PageBounds.Width-$sz.Width)/2, ($e.PageBounds.Height-$sz.Height)/2)

            # Headers
            for ($col=0; $col -lt $dataGridView.ColumnCount; $col++) {
                $e.Graphics.DrawRectangle($pen, $x, $y, $cellWidth, $cellHeight)
                $e.Graphics.DrawString($dataGridView.Columns[$col].HeaderText, $font, $brush, $x+5, $y+5)
                $x += $cellWidth
            }
            $x = 50; $y += $cellHeight

            # Rows
            for ($row=0; $row -lt $dataGridView.Rows.Count; $row++) {
                for ($col=0; $col -lt $dataGridView.Columns.Count; $col++) {
                    $val = $dataGridView.Rows[$row].Cells[$col].Value
                    $e.Graphics.DrawRectangle($pen, $x, $y, $cellWidth, $cellHeight)
                    if ($val) { $e.Graphics.DrawString($val.ToString(), $font, $brush, $x+5, $y+5) }
                    $x += $cellWidth
                }
                $x = 50; $y += $cellHeight
            }
        })
        $printDocument.Print()
    } catch {
        [System.Windows.Forms.MessageBox]::Show("An error occurred while printing: $_")
    }
}

